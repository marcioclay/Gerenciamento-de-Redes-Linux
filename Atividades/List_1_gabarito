## 1) Controle de processos
sleep 300
Ctrl+Z
bg
jobs
ps
kill PID

## 2) Visualização de processos

ps aux
top
pstree
echo $$


## 3) Finalizar processo pelo nome

yes &
killall yes


## 4) Criar usuário

sudo adduser aluno_proc


## 5) Criar grupo e adicionar usuário

sudo groupadd turma_proc
sudo usermod -aG turma_proc aluno_proc


## 6) Ver UID, GID e grupos

id aluno_proc
groups aluno_proc

